+/// Walk only the native ownership roster. Each session keeps its own scheduler and queue.
+async fn eval_family(link: &Arc<DaemonLink>, root: &str, operation: &str) -> anyhow::Result<Value> {
+    let mut pending = std::collections::VecDeque::from([root.to_string()]);
+    let mut seen = std::collections::HashSet::new();
+    let mut root_state = Value::Null;
+    let mut next_wake: Option<u64> = None;
+    let mut active_work = false;
+    while let Some(session_id) = pending.pop_front() {
+        if !seen.insert(session_id.clone()) {
+            continue;
+        }
+        let mut rest = Map::new();
+        rest.insert("overnightEval".to_string(), json!(operation));
+        let response = link.request_until_close(DaemonCommand::GetConnectionState {
+            id: None,
+            active_session_id: session_id.clone(),
+            rest,
+        }).await?;
+        if !response.success {
+            anyhow::bail!(response.error.unwrap_or_else(|| "native family evaluation failed".to_string()));
+        }
+        let data = response.data.unwrap_or(Value::Null);
+        active_work |= data.get("isStreaming").and_then(Value::as_bool).unwrap_or(false)
+            || data.get("isCompacting").and_then(Value::as_bool).unwrap_or(false)
+            || data.pointer("/sessionActions/queuedCount").and_then(Value::as_u64).unwrap_or(0) > 0;
+        if let Some(wake) = data.pointer("/overnightEval/nextWakeMs").and_then(Value::as_u64) {
+            next_wake = Some(next_wake.map_or(wake, |previous| previous.min(wake)));
+        }
+        if session_id == root {
+            root_state = data;
+        }
+        if operation == "reset" || operation == "cancel" {
+            break; // Native retirement closes the entire child tree.
+        }
+        for child in fetch_rlm_children(link, &session_id).await? {
+            active_work |= child.get("status").and_then(Value::as_str) == Some("running");
+            if let Some(child_id) = child.get("activeSessionId").and_then(Value::as_str) {
+                pending.push_back(child_id.to_string());
+            }
+        }
+    }
+    root_state["overnightEval"]["nextWakeMs"] = json!(next_wake);
+    root_state["overnightEval"]["activeWork"] = json!(active_work);
+    Ok(root_state)
 }
 
