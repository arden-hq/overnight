+//! Optional process-scoped evaluation clock. Production uses the system clock.
+
+/// Return epoch milliseconds from the configured evaluation clock, or wall time.
+pub fn now_ms() -> u64 {
+    match std::env::var_os("PRIME_AGENT_EVAL_CLOCK") {
+        Some(path) => std::fs::read_to_string(path)
+            .expect("read evaluation clock")
+            .trim()
+            .parse()
+            .expect("evaluation clock must contain unsigned epoch milliseconds"),
+        None => std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .map_or(0, |duration| duration.as_millis() as u64),
+    }
+}
